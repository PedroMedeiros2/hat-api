# Copie para .env (fora do git) e preencha. No servidor, os mesmos nomes vão no deploy/.env do GAW.

# SPData (Firebird), usuário SOMENTE LEITURA
SGH_DB_URL=jdbc:firebirdsql://192.168.0.251:3050//srv/sghdatabase/sghdados.828?encoding=WIN1252&roleName=ROLE_LEITURA_TODAS_AS_TABELAS
SGH_DB_USER=
SGH_DB_PASSWORD=
# Pool (opcional): conexões sempre abertas e máximo
# SGH_DB_POOL_MIN_IDLE=1
# SGH_DB_POOL_MAX=5

# Login único do GAW: endereço público do GAW e o código desta aplicação no catálogo do GAW
GAW_ISSUER=http://localhost:3000
# Chave pública do GAW; vazio = {GAW_ISSUER}/oauth2/jwks
GAW_JWKS_URI=
GAW_APLICACAO=indicadores
# Banco proprio do painel (PostgreSQL do GAW, banco "indicadores"): cadastro CNES. Vazio = so leitura.
INDICADORES_DB_URL=jdbc:postgresql://HOST:55432/indicadores
INDICADORES_DB_USER=indicadores_app
INDICADORES_DB_PASSWORD=
